<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <widgets>
        <render-mode><text type="html"><![CDATA[<html><body>]]></text></render-mode>
        <container><label text="Parola de resetare este: ${resetPassword}"/></container>
        <container><label text="Vă rugăm să folosiți imediat această parolă de resetare pentru a vă seta o parolă nouă."/></container>
        <container><label text="Parola dumneavoastră curentă este încă valabilă, puteți folosi parola de resetare doar pentru a vă schimba parola curentă."/></container>
        <section name="RequireChangeSection" condition="userAccount.requirePasswordChange == 'Y'"><widgets>
            <container><label text="Parola dumneavoastră trebuie schimbată înainte de a vă conecta."/></container>
        </widgets></section>
        <render-mode><text type="html"><![CDATA[</body></html>]]></text></render-mode>
    </widgets>
</screen>
